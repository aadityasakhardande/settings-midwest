<?xml version="1.0"?>
<robot name="rail" xmlns:xacro="http://wiki.ros.org/xacro">
  <link name="rail_origin">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      	<geometry>
            <mesh filename="file:///etc/ss/rails/models/10M_RAIL_520.STL" scale="1 1 1"/> 
      	</geometry>
	  	  <material name="ABS" >
          	<color rgba="0.5 0.5 0.5 1.0" />
        </material> 	
    	</visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/> 
        <geometry>
          <mesh filename="file:///etc/ss/rails/models/rail_box_520.STL" scale="1 1 1"/> 
        </geometry>
        <material name="ABS" >
          	<color rgba="0.5 0.5 0.5 1.0" />
        </material> 
      </collision>
  </link>
</robot>