{
    "$schema": "../../../schemas/segmentation.schema.json",
    "globals": {
        "debug_mode": true
    },
    "functions": [
        {
            "function": "downsample",
            "params": {
                "leaf_sizes": [0.003, 0.003, 0.003],
                "algorithm": 1
            }
        },        
        {
            "function": "compute_normal",
            "params": {
                "use_pcl": true,
                "use_jet": false,
                "use_radius": true,
                "K": 50,
                "radius_normal": 0.03,
                "viewpoint_normal": [
                    1.0,
                    1.5,
                    2.0
                ],
                "flip_normals": false,
                "maintain_normals": true,
                "colourize": true,
                "field": 1,
                "eucledian_cluster": true,
                "cluster_tolerance": 0.01,
                "min_cluster_size": 10000,
                "max_cluster_size": 10000000,
                "use_gpu": true
            }
        },
        {
            "function": "eucledian_clustering",
            "params": {
                "cluster_tolerance": 0.01,
                "min_cluster_size": 100,
                "max_cluster_size": 25000,
                "save_debug": false
            }
        },
        {
            "function": "vcm_segmentation",
            "params": {
                "convolution_radius": 0.02,
                "offset_radius": 0.018,
                "threshold_ratio": 0.1,
                "distribute": false,
                "cluster_tolerance": 0.01,
                "min_cluster_size": 10,
                "max_cluster_size": 10000000,
                "vis_minValRatio": 0.05,
                "vis_maxValRatio": 0.1,
                "algo_type": 1,
                "no_of_segments": 36,
                "direction": 1,
                "min_width": 0.15
            }
        },
        {
            "function": "projection_segmentation",
            "params": {
                "algorithm": 4,
                "maxAngleDeviation": 10,
                "custom_seed_activate": true,
                "custom_first_seed": [
                    0.0,
                    0.0,
                    1.0
                ],
                "cluster_tolerance": 0.01,
                "min_cluster_size": 10,
                "max_cluster_size": 10000000,
                "noise_max_size": 50,
                "introduce_overlap": false,
                "overlap_radius": 0.055,
                "boundary_radius": 0.01,
                "overlap_mode": 2,
                "remove_clouds_along": [5],
                "debug": true,
                "leaf_size": [
                    0.01,
                    0.01,
                    0.01
                ],
                "multiple_custom_seeds": [
                    [
                        0,
                        0,
                        1
                    ],
                    [
                        0,
                        1,
                        0
                    ],
                    [
                        0,
                        -1,
                        0
                    ]
                ],
                "do_alignment_correction": false
            }
        }
    ],
    "examples": [
        {
            "function": "flip_normals"
        },
        {
            "function": "swept_cylinder",
            "params": {
                "radius": 0.045,
                "height": 1.5,
                "surface_offset": 0.015,
                "include_high_curvature": false,
                "downsample": false,
                "include_euclidean_discard": false,
                "include_self": true,
                "leaf_size": [
                    0.01,
                    0.01,
                    0.01
                ],
                "cluster": false,
                "cluster_tolerance": 0.01,
                "min_cluster_size": 3000,
                "max_cluster_size": 10000000,
                "fast_mode": false,
                "use_old": false,
                "save_debug": false,
                "reverse_result": false,
                "use_gpu": false
            }
        },
        {
            "function": "flip_normals"
        }
        ,
        {
            "function": "bounding_box_filter",
            "params": {
                "bounding_boxes":
                    [
                    [-1.27,-2.20,1.5,3.5,-0.125,0.121]],
                "keep_clouds_inside_bbox": false
            }
        }
    ]
}
