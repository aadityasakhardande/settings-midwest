{
    "$schema": "/etc/ss/config/system_config/schemas/segmentation.schema.json",
    "globals": {
        "debug_mode": true
    },
    "functions": [
        {
            "function": "mls_smoothening",
            "params": {
                "algorithm": "NONE",
                "polynomial_order": 2,
                "search_radius": 0.01,
                "upsampling_radius": 0.04,
                "upsampling_step_size": 0.001,
                "point_density": 20,
                "dilation_iterations": 5,
                "voxel_size": 0.01,
                "compute_normal": false
            }
        },
        {
            "function": "remove_mask_filter",
            "params": {
                "masks": [0, 255, 0],
                "mask_search_radius": true,
                "search_radius": 0.008
            }
        },
        {
        "function": "downsample",
        "params": {
            "leaf_sizes": [
                0.007,
                0.007,
                0.007
            ]
        }
        },
        {
            "function": "curvature_segmentation",
            "params": {
                "curvature_threshold": [0.003, 0.15],
                "princ_curv_radius": 0.005,
                "cluster_tolerance": 0.05,
                "distribute": false,
                "min_cluster_size": 100,
                "max_cluster_size": 10000000,
                "noise_max_size": 50,
                "cluster": true,
                "approx_density_measure": 0.01,
                "boundary_detection_tol": 0.02,
                "debug": true,
                "ignore_lower_percentage": 0,
                "ignore_top_percentage": 100,
                "keep_only_high_curvatures": false,
                "leaf_size": [
                    0.01,
                    0.01,
                    0.01
                ],
                "min_regular_cluster": 100,
                "preserve_corners": false,
                "split_by_thin": false,
                "thin_feature_measure": 0.1,
                "use_gpu": true
            }
        },
        {
            "function": "eucledian_clustering",
            "params": {
                "cluster_tolerance": 0.02,
                "min_cluster_size": 10000,
                "max_cluster_size": 10000000,
                "save_debug": false
            }
        },
        {
            "function": "swept_cylinder",
            "params": {
                "radius": 0.08,
                "height": 0.08,
                "surface_offset": 0.01,
                "include_high_curvature": false,
                "downsample": false,
                "include_euclidean_discard": true,
                "include_self": true,
                "leaf_size": [
                    0.01,
                    0.01,
                    0.01
                ],
                "cluster": true,
                "cluster_tolerance": 0.015,
                "min_cluster_size": 500,
                "max_cluster_size": 10000000,
                "fast_mode": false,
                "use_old": false,
                "save_debug": false,
                "reverse_result": false,
                "use_gpu": true
            }
        }, 
        {
            "function": "eucledian_clustering",
            "params": {
                "cluster_tolerance": 0.02,
                "min_cluster_size": 40000,
                "max_cluster_size": 10000000,
                "save_debug": false
            }
        },
        {
            "function": "compute_normal",
            "params": {
                "use_pcl": true,
                "use_jet": false,
                "use_radius": true,
                "K": 60,
                "radius_normal": 0.025,
                "viewpoint_normal": [
                    0.0,
                    4.0,
                    5.0
                ],
                "flip_normals": false,
                "maintain_normals": true,
                "colourize": true,
                "field": 1,
                "eucledian_cluster": false,
                "cluster_tolerance": 0.01,
                "min_cluster_size": 100,
                "max_cluster_size": 10000000,
                "use_gpu": true
            }
        }, 
        {
            "function": "mls_smoothening",
            "params": {
                "algorithm": "NONE",
                "polynomial_order": 2,
                "search_radius": 0.04,
                "upsampling_radius": 0.04,
                "upsampling_step_size": 0.01,
                "point_density": 20,
                "dilation_iterations": 5,
                "voxel_size": 0.01,
                "compute_normal": false
            }
        },
        {
            "function": "eucledian_clustering",
            "params": {
                "cluster_tolerance": 0.02,
                "min_cluster_size": 10000,
                "max_cluster_size": 10000000,
                "save_debug": false
            }
        }
              
    ]
}
