        },
        {
            "function": "downsample",
            "params": {
                "leaf_sizes": [0.003, 0.003, 0.003],
                "algorithm": 1
            }
        },        
        {
            "function": "compute_normal",
            "params": {
                "use_pcl": true,
                "use_jet": false,
                "use_radius": true,
                "K": 50,
                "radius_normal": 0.03,
                "viewpoint_normal": [
                    1.0,
                    1.5,
                    2.0
                ],
                "flip_normals": false,
                "maintain_normals": true,
                "colourize": true,
                "field": 1,
                "eucledian_cluster": true,
                "cluster_tolerance": 0.01,
