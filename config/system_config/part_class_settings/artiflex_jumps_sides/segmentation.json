            "params": {
                "cluster_tolerance": 0.01,
                "min_cluster_size": 41000,
                "max_cluster_size": 10000000,
                "save_debug": false
            }
        },
        {
            "function": "projection_segmentation",
            "params": {
                "algorithm": 4,
