{
  "$schema": "./schemas/stitchConfig.schema.json",
  "doc": {
    "purpose": "This file is called when stitching the pointclouds that are scanned, and what are preprocessing functions should be applied on the incoming cloud.",
    "Notes": "Currently we do not support the functions: NormalComputation (use PCLNormalComputation instead), XRemoval, so changing those parameters will not effect anything"
  },
  "DB_Scan": {
    "dbScanToggle": false,
    "ClusterTolerance": 0.023,
    "ClusterCorePoints": 21
  },
  "MeshCreation": {
    "meshCreation_LeafSize": 0.02,
    "meshCreation_SearchRadius": 0.12,
    "meshCreation_Mu": 4.0,
    "meshCreation_MaximumNearestNeighbors": 100,
    "meshCreation_MaximumSurfaceAngleDiv": 1.0,
    "meshCreation_MinimumAngleDiv": 18,
    "meshCreation_MaximumAngleDiv": 1,
    "meshCreation_downsamplingAlgorithm": 1
  },
  "MLSFilter": {
    "kPolynomialOrderMLS": 3,
    "kSpacingForMLS": 0.003,
    "kNeighborhoodRadiusMLS": 0.015,
    "downsamplingAlgorithm": 1
  },
  "GaussianFilter": {
    "kSpacingForGaussian": 0.004,
    "kKernelWidthGaussianFilter": 0.008
  },
  "removeOutliers": {
    "removeOutliersToggle_EachSegment": true,
    "removeOutliersMeanK": 10,
    "removeOutliersStddevMulThresh": 2,
    "removeOutliersToggle_MrgdCld": false,
    "removeOutliersMeanK_MrgdCld": 10,
    "removeOutliersStddevMulThresh_MrgdCld": 2
  },
  "NormalComputation": {
    "normal_iterations": 4,
    "normal_constant1": 0.1,
    "normal_constant2": 0.01,
    "normal_eps": 0.1,
    "normal_noise_std_dev": 0.001,
    "normal_maxNeighbors": 175,
    "normal_RiemanGraphNeighbors": 15
  },
  "PCLNormalComputation": {
    "pcl_normal_estimation_radius": 0.015,
    "pcl_normal_estimation_use_radius": true,
    "pcl_normal_estimation_No_of_Neighbors": 30,
    "pcl_normal_estimation_no_of_threads": 32
  },
  "EuclideanCluster": {
    "euclClusterToggle_MrgdCld": true,
    "euclCluster_min_cluster_size_MrgdCld": 100000,
    "euclCluster_max_cluster_size_MrgdCld": 10000000,
    "euclCluster_cluster_tolerance_MrgdCld": 0.0075
  },
  "downsample": {
    "activate": true,
    "downsamplingLeafSize": 0.0035,
    "downsamplingAlgorithm": 1
  },
  "MergedPointcloudDownsample": {
    "activate": false,
    "downsamplingLeafSize": 0.0035,
    "downsamplingAlgorithm": 1
  },
  "VisualizationDownsample": {
    "activate": true,
    "downsamplingLeafSize": 0.008,
    "downsamplingAlgorithm": 1
  },
  "XRemoval": {
    "remove_x_masked_points": false,
    "boundary_search_radius": 0.015,
    "boundary_cluster_tolerance": 0.03,
    "boundary_min_cluster_size": 100,
    "boundary_max_cluster_size": 10000000,
    "eucl_cluster_tolerance": 0.01,
    "eucl_cluster_min_size": 100,
    "eucl_cluster_max_size": 10000000
  },
  "AddCustomCollisionModelToWorkpiece": {
    "activate": false,
    "cloud_file_path": "<relative_path_to_custom_collision_cloud>.ply"
  },
  "ShadowMeshGenerator": {
    "activate": false,
    "alpha": 0.3,
    "downsample_leaf_size": [0.1, 0.1, 0.1],
    "voxel_size": 0.1,
    "point_spacing": 0.3,
    "max_ray_distance": 101.0,
    "intersection_radius": 1.0,
    "min_cluster_size": 100,
    "max_cluster_size": 2500000,
    "cluster_tolerance": 0.3,
    "view_points": [
      [-10, 10, 100.0],
      [-10, -10, 100.0]
    ]
  },
  "GeneralAlphaWrap": {
    "alphaWrap_alpha": 0.05,
    "alphaWrap_offset": 0.1,
    "alphaWrap_confidence": true,
    "alphaWrap_manifold": false,
    "alphaWrap_output_polygons": false,
    "alphaWrap_depth": 8,
    "alphaWrap_min_depth": 3,
    "alphaWrap_solver_divide": 3,
    "alphaWrap_iso_divide": 1,
    "alphaWrap_samples_per_node": 1,
    "alphaWrap_scale": 1,
    "alphaWrap_point_weignt": 4
  },
  "ConservativeAlphaWrap": {
    "alphaWrap_alpha": 0.05,
    "alphaWrap_offset": 0.1,
    "alphaWrap_confidence": true,
    "alphaWrap_manifold": false,
    "alphaWrap_output_polygons": false,
    "alphaWrap_depth": 8,
    "alphaWrap_min_depth": 3,
    "alphaWrap_solver_divide": 3,
    "alphaWrap_iso_divide": 1,
    "alphaWrap_samples_per_node": 1,
    "alphaWrap_scale": 1,
    "alphaWrap_point_weignt": 4
  }
}
