{
    "$schema": "/etc/ss/config/system_config/schemas/segmentation.schema.json",
    "globals": {
        "debug_mode": true
    },
    "functions": [
            {
        "function": "downsample",
        "params": {
            "leaf_sizes": [
                0.005,
                0.005,
                0.005
            ]
        }
        }, 
        {
            "function": "remove_mask_filter",
            "params": {
            "masks": 
                [
                    255,
                    0,
                    0,
                    0,
                    255,
                    0
                ],
            "mask_search_radius": true,
            "search_radius": 0.01
            }
        },    
        {
            "function": "vcm_segmentation",
            "params": {
                "convolution_radius": 0.004,
                "offset_radius": 0.025,
                "threshold_ratio": 0.05,
                "distribute": false,
                "cluster_tolerance": 0.01,
                "min_cluster_size": 500,
                "max_cluster_size": 10000000,
                "vis_minValRatio": 0.05,
                "vis_maxValRatio": 0.1,
                "algo_type": 1,
                "no_of_segments": 36,
                "direction": 1,
                "min_width": 0.15
            }
        },
        {
            "function": "curvature_segmentation",
            "params": {
                "curvature_threshold": 	[0.0089, 0.152],
                "princ_curv_radius": 0.01,
                "cluster_tolerance": 0.06,
                "min_cluster_size": 500,
                "max_cluster_size": 10000000,
                "noise_max_size": 50,
                "distribute": false,
                "cluster": true,
                "keep_only_high_curvatures": false,
                "debug": false,
                "ignore_lower_percentage": 0,
                "ignore_top_percentage": 100,
                "leaf_size": [
                    0.01,
                    0.01,
                    0.01
                ],
                "split_by_thin": false,
                "thin_feature_measure": 0.1,
                "boundary_detection_tol": 0.02,
                "preserve_corners": false,
                "min_regular_cluster": 100,
                "approx_density_measure": 0.01,
                "use_gpu": true
            }
        },
                {
            "function": "eucledian_clustering",
            "params": {
                "cluster_tolerance": 0.007,
                "min_cluster_size": 50000,
                "max_cluster_size": 10000000,
                "save_debug": false
            }
        },
        {
            "function": "mls_smoothening",
            "params": {
                "algorithm": "NONE",
                "polynomial_order": 2,
                "search_radius": 0.028,
                "upsampling_radius": 0.04,
                "upsampling_step_size": 0.01,
                "point_density": 20,
                "dilation_iterations": 5,
                "voxel_size": 0.01,
                "compute_normal": false
            }
        },
        {
            "function": "compute_normal",
            "params": {
                "use_pcl": false,
                "use_jet": false,
                "use_radius": true,
                "K": 62,
                "radius_normal": 0.025,
                "viewpoint_normal": [
                    0.0,
                    4.0,
                    5.0
                ],
                "flip_normals": false,
                "maintain_normals": true,
                "colourize": true,
                "field": 1,
                "eucledian_cluster": true,
                "cluster_tolerance": 0.01,
                "min_cluster_size": 100,
                "max_cluster_size": 10000000,
                "use_gpu": true
            }
        },

        {
            "function": "eucledian_clustering",
            "params": {
                "cluster_tolerance": 0.007,
                "min_cluster_size": 1000,
                "max_cluster_size": 10000000,
                "save_debug": false
            }
        }        
    ]
}