{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Compound-Nozzle Mapping List",
    "type": "object",
    "properties": {
        "data": {
            "description": "this data list shows the mapping relationship from compound to nozzle, and it is also the list for the compound types that would be using during scan&polish",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "compound": {
                        "description": "the name for the compound type",
                        "type": "string"
                    },
                    "nozzle": {
                        "description": "the id for the corresponding nozzle, start from 0",
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "required": [
                    "compound",
                    "nozzle"
                ]
            }
        }
    },
    "required": [
        "data"
    ]
}